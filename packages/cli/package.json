{
  "name": "@copybook/cli",
  "version": "0.1.1",
  "description": "Catalog, snapshot, test, and evaluate the snippets and agent prompts in your product.",
  "keywords": [
    "agent",
    "cli",
    "code-snippets",
    "devrel",
    "evals",
    "prompts"
  ],
  "homepage": "https://copybook.dev",
  "bugs": {
    "url": "https://github.com/neon-solutions/copybook/issues"
  },
  "license": "MIT",
  "author": "Neon Inc. (https://neon.com)",
  "contributors": [
    "OrcDev (https://orcdev.com)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neon-solutions/copybook.git",
    "directory": "packages/cli"
  },
  "bin": {
    "copybook": "dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@copybook/core": "workspace:*",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "oxc-parser": "^0.155.0",
    "oxc-resolver": "^11.24.2",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@copybook/studio": "workspace:*",
    "@types/node": "^24",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
