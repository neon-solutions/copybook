{
  "name": "copybook",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "predev": "pnpm build:packages",
    "build": "next build",
    "prebuild": "pnpm build:packages && pnpm registry:build",
    "start": "next start",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "test": "pnpm --filter \"./packages/*\" test",
    "lint": "oxlint",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "pnpm build:packages && next typegen && tsc --noEmit && pnpm --filter \"./packages/*\" --filter \"./examples/*\" typecheck",
    "prepare": "husky",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:packages": "pnpm build:packages && pnpm --filter \"./packages/*\" lint:package && pnpm --filter @copybook/core size",
    "registry:build": "shadcn build",
    "check:content": "copybook check && pnpm --filter @copybook/example-acme exec copybook check",
    "dev:studio": "pnpm --filter @copybook/cli build && (cd examples/acme && copybook studio --api-only) & pnpm --filter @copybook/studio dev",
    "test:content": "copybook test && pnpm --filter @copybook/example-acme exec copybook test --tier syntax,typecheck,run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@copybook/core": "workspace:*",
    "@copybook/example-acme": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fumadocs-core": "^16.17.7",
    "fumadocs-mdx": "^15.4.9",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.17.7",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@copybook/cli": "workspace:*",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "ultracite": "8.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.14.0"
}
